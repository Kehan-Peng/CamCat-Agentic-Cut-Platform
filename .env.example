# Copy to .env and replace every change-me value. Provider services must be real;
# CamCat deliberately has no mock/fallback provider.
CAMCAT_DATABASE_URL=postgresql+psycopg://camcat:camcat@postgres:5432/camcat
CAMCAT_OBJECT_STORE_ENDPOINT=http://minio:9000
CAMCAT_OBJECT_STORE_PUBLIC_ENDPOINT=http://localhost:9000
CAMCAT_OBJECT_STORE_ACCESS_KEY=camcat
CAMCAT_OBJECT_STORE_SECRET_KEY=change-me-minio-secret
CAMCAT_OBJECT_STORE_BUCKET=camcat
CAMCAT_MILVUS_URI=http://milvus:19530
CAMCAT_MILVUS_TOKEN=
CAMCAT_MILVUS_COLLECTION=camcat_segments_v3

# local-single-user ignores browser X-User-Id and binds all data to LOCAL_USER_ID.
# multi-user requires identity headers from a trusted reverse proxy plus both secrets.
CAMCAT_SECURITY_MODE=local-single-user
CAMCAT_LOCAL_USER_ID=camcat-local-user
CAMCAT_TRUSTED_PROXY_SECRET=
CAMCAT_LIBRARY_ADMIN_KEY=

# Qwen3-VL-Embedding gateway contract: docs/provider-contract.md
CAMCAT_EMBEDDING_BASE_URL=https://change-me.example.com
CAMCAT_EMBEDDING_API_KEY=change-me
CAMCAT_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
CAMCAT_EMBEDDING_DIMENSION=2048
CAMCAT_EMBEDDING_VIDEO_FPS=1.0
CAMCAT_EMBEDDING_VIDEO_MAX_FRAMES=64
CAMCAT_JOB_LEASE_SECONDS=600

# Qwen3-VL-Reranker gateway contract: docs/provider-contract.md
CAMCAT_RERANKER_BASE_URL=https://change-me.example.com
CAMCAT_RERANKER_API_KEY=change-me
CAMCAT_RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-8B

# OpenAI-compatible Qwen chat endpoint plus CamCat's direct video description route.
CAMCAT_LLM_BASE_URL=https://change-me.example.com
CAMCAT_LLM_API_KEY=change-me
CAMCAT_LLM_MODEL=qwen3-vl-plus

# OpenAI-compatible transcription endpoint.
CAMCAT_ASR_BASE_URL=https://change-me.example.com
CAMCAT_ASR_API_KEY=change-me
CAMCAT_ASR_MODEL=qwen3-asr-flash

# Optional Pixabay search importer. Without it, the seed script uses the real
# short sample explicitly published in Pixabay's API documentation.
PIXABAY_API_KEY=change-me

# Frontend build/runtime values.
VITE_CAMCAT_API_BASE=http://localhost:8000
VITE_CAMCAT_USER_ID=camcat-local-user
